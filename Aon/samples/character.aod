// Ambermoon character data format definitions
// Source: Characters.md (Party_char.amb, NPC_char.amb, Monster_char.amb)
// All multi-byte values are big-endian.

enum CharacterType : ubyte {
    PartyMember,   // 0x00
    NPC,           // 0x01
    Monster        // 0x02
}

enum Gender : ubyte {
    Male,
    Female,
    None
}

enum Race : ubyte {
    Human,           // 0
    Elf,             // 1
    Dwarf,           // 2
    Gnome,           // 3
    HalfElf,         // 4
    Sylph,           // 5
    Feline,          // 6
    Moranian,        // 7
    Thalionic,       // 8
    Animal = 13,     // only Necros the cat NPC
    Monster = 14     // all non-human monsters
}

enum Class : ubyte {
    Adventurer,      // 0
    Warrior,         // 1
    Paladin,         // 2
    Thief,           // 3
    Ranger,          // 4
    Healer,          // 5
    Alchemist,       // 6
    Mystic,          // 7
    Mage,            // 8
    Animal,          // 9 - only Necros the cat NPC
    Monster          // 10 - monsters who aren't mages, thieves, etc.
}

bitfield SpellTypes : ubyte {
    Healing,                    // 0x01 - white spells
    Alchemistic,                // 0x02 - blue spells
    Mystic,                     // 0x04 - green spells
    Destruction,                // 0x08 - black spells
    IncreasedEarthSpellDamage,  // 0x10 - Ambermoon Advanced only
    IncreasedWindSpellDamage,   // 0x20 - Ambermoon Advanced only
    IncreasedFireSpellDamage,   // 0x40 - Ambermoon Advanced only
    MasteredSpells              // 0x80 - class has mastered these spells
}

bitfield Languages : ubyte {
    Human,      // 0x01
    Elfish,     // 0x02
    Dwarfish,   // 0x04
    Gnomish,    // 0x08
    Sylphic,    // 0x10
    Felinic,    // 0x20
    Morag,      // 0x40
    Animal      // 0x80
}

bitfield BattleFlags : ubyte {
    Undead,                     // 0x01 - can be killed by holy spells
    Demon,                      // 0x02
    Boss,                       // 0x04 - immune to fear, paralyze, petrify, etc.
    Animal,                     // 0x08
    IncreasedEarthSpellDamage,  // 0x10 - Ambermoon Advanced only
    IncreasedWindSpellDamage,   // 0x20 - Ambermoon Advanced only
    IncreasedFireSpellDamage,   // 0x40 - Ambermoon Advanced only
    Unused                      // 0x80
}

bitfield Elements : ubyte {
    Unknown,    // 0x01 - unknown effect
    Psychic,    // 0x02 - immune to MonsterKnowledge, Fear, Sleep, Irritation, Madness
    Ghost,      // 0x04 - immune to DissolveVictim, Blindness, GhostWeapon, MagicProjectile
    Undead,     // 0x08 - immune to LP-Stealer
    Earth,      // 0x10 - immune to Poison, Paralyze, Disease, LP-Stealer
    Wind,       // 0x20
    Fire,       // 0x40
    Water       // 0x80
}

bitfield Conditions : uword {
    Irritated,      // 0x0001 - can't cast spells (battle-only)
    Crazy,          // 0x0002 - random battle actions, no inventory access
    Sleep,          // 0x0004 - no orders; ends on damage (battle-only)
    Panic,          // 0x0008 - flees automatically (battle-only)
    Blind,          // 0x0010 - black map view, reduced hit chance
    Drugged,        // 0x0020 - stoned; fancy colors
    Exhausted,      // 0x0040 - all values halved, damaged each hour
    Fleeing,        // 0x0080 - about to flee
    Paralyzed,      // 0x0100 - can't move or attack
    Poisoned,       // 0x0200 - damage each battle round or ingame hour
    Petrified,      // 0x0400 - total immunity, can't act or be damaged
    Diseased,       // 0x0800 - random attribute decreases each day
    Aging,          // 0x1000 - age increases each day
    DeadCorpse,     // 0x2000
    DeadAshes,      // 0x4000 - needs transformation before revival
    DeadDust        // 0x8000 - needs transformation before revival
}

// Ambermoon Advanced only — stored at offset 0x000B for monsters
bitfield AdvancedMonsterFlags : ubyte {
    ImmuneNoElement,   // 0x01 — misses every attack without element
    Unused,            // 0x02
    ImmuneGhost,       // 0x04
    ImmuneUndead,      // 0x08
    ImmuneEarth,       // 0x10
    ImmuneWind,        // 0x20
    ImmuneFire,        // 0x40
    ImmuneWater        // 0x80
}

// Each stat/ability has four components: current, max, signed bonus, backup.
// Total size: 8 bytes.
struct CharacterValue {
    uword Current
    uword Max
    sword Bonus
    uword Backup
}

// ---------------------------------------------------------------
// Base character record (offsets are from the start of the record)
// ---------------------------------------------------------------
struct Character [Size = 0x0122] {
    [0x0000]
    CharacterType Type
    Gender Gender
    Race Race
    Class Class
    SpellTypes UsableSpellTypes
    ubyte Level
    ubyte NumOccupiedHands
    ubyte NumOccupiedFingers
    Languages SpokenLanguages
    ubyte InventoryInaccessible
    ubyte PortraitIndex
    [0x000B]
    ubyte? JoinPercentage = 0            // 0 = will never join; only used in Amberstar
    ubyte? CombatGraphicIndex = 0        // monsters only
    ubyte? SpellChancePercentage = 0     // monsters only (unused in Ambermoon)
    ubyte? MagicBonusToHit = 0          // monsters only (unused in Ambermoon)
    ubyte? MonsterMorale = 0            // retreat chance; 100 = never flee
    ubyte? SpellImmunity = 0
    ubyte AttacksPerRound
    BattleFlags? BattleFlags = 0
    Elements? ElementsAndImmunities = 0
    [0x0014]
    uword? SpellLearningPoints = 0
    uword? TrainingPoints = 0
    [0x0018]
    uword? Gold = 0
    uword? Food = 0
    uword? CharacterBitIndex = 0xFFFF   // 0xFFFF = not used
    Conditions? Conditions = 0
    uword? MonsterExperience = 0        // XP rewarded when this monster is defeated
    uword? BattleRoundSpellPointUsage = 0
    uword? MarkOfReturnX = 0
    uword? MarkOfReturnY = 0
    uword? MarkOfReturnMapIndex = 0
    [0x002A]
    CharacterValue[8] Attributes        // STR, INT, DEX, SPD, STA, CHA, LUK, AntiMagic
    [0x006A]
    CharacterValue Age
    CharacterValue? SpellDamageBonus    // 10th attribute (Ambermoon Advanced)
    [0x007A]
    CharacterValue[10] Abilities        // ATT, PAR, SWI, CRI, FindTraps, DisarmTraps, LockPick, Search, ReadMagic, UseMagic
    [0x00CA]
    uword CurrentHitPoints
    uword MaxHitPoints
    uword? BonusHitPoints = 0
    uword CurrentSpellPoints
    uword MaxSpellPoints
    uword? BonusSpellPoints = 0
    sword? BaseDefense = 0              // monsters only
    sword? BonusDefense = 0            // from equipment
    sword? BaseAttackDamage = 0        // monsters only
    sword? BonusAttackDamage = 0       // from equipment
    uword? MagicAttackLevel = 0
    uword? MagicDefenseLevel = 0
    uword? APRIncreaseLevels = 0
    uword HitPointsPerLevel
    uword? SpellPointsPerLevel = 0
    uword? SpellLearningPointsPerLevel = 0
    uword? TrainingPointsPerLevel = 0
    uword? LookTextIndex = 0xFFFF       // 0xFFFF = none
    [0x00EE]
    udword? Experience = 0
    udword? LearnedHealingSpells = 0
    udword? LearnedAlchemisticSpells = 0
    udword? LearnedMysticSpells = 0
    udword? LearnedDestructionSpells = 0
    udword?[3] LearnedFunctionalSpells = 0
    udword? Weight = 0
    [0x0112]
    ubyte[16] Name                      // DOS Latin-1 (codepage 850), null-terminated
}

// ---------------------------------------------------------------
// Monster-specific record — inherits all Character fields
// ---------------------------------------------------------------

// Each animation stores 32 frame indices (into the monster graphic).
struct AnimationInfo {
    ubyte[32] FrameIndices
}

struct Monster : Character [Size = 0x032A] {
    Type = CharacterType.Monster
    [0x000B]
    new AdvancedMonsterFlags? MonsterFlags = 0  // replaces JoinPercentage in Character
    [0x01E8]
    AnimationInfo[8] Animations  // Move, ShortAttack, LongAttack, Cast, Hurt, Die, StartAnim, Unknown
    ubyte[8] FrameCounts
    ubyte[16] AtariPalette
    ubyte[32] AmigaPalette
    ubyte? AnimationDirectionFlags = 0  // bit N set = animation N plays backwards after finishing
    ubyte? Padding = 0
    [0x0322]
    uword? FrameWidth = 0
    uword? FrameHeight = 0
    uword? MappedFrameWidth = 0
    uword? MappedFrameHeight = 0
}
