// Ambermoon character data format definitions
// Source: Characters.md (Party_char.amb, NPC_char.amb, Monster_char_data.amb)
// All multi-byte values are big-endian.

enum CharacterType : ubyte {
    PartyMember,   // 0x00
    NPC,           // 0x01
    Monster        // 0x02
}

enum Gender : ubyte {
    Male,
    Female,
    None
}

enum Race : ubyte {
    Human,
    Elf,
    HalfElf,
    Dwarf,
    Gnome,
    Halfling,
    Animal,
    Monster
}

enum Class : ubyte {
    Adventurer,
    Warrior,
    Paladin,
    Thief,
    Ranger,
    Healer,
    Alchemist,
    Mystic,
    Mage,
    Animal
}

bitfield SpellTypes : ubyte {
    Healing,       // 0x01
    Alchemistic,   // 0x02
    Mystic,        // 0x04
    Destruction,   // 0x08
    Unused1,       // 0x10
    Unused2,       // 0x20
    Functional     // 0x40
}

bitfield Languages : ubyte {
    Human,         // 0x01
    Dwarf,         // 0x02
    Gnome,         // 0x04
    Elf,           // 0x08
    Monster        // 0x10
}

bitfield BattleFlags : ubyte {
    Monster,           // 0x01
    Boss,              // 0x02
    DontMove,          // 0x04
    Undead,            // 0x08
    Demon,             // 0x10
    DropNoPseudoItem   // 0x20
}

bitfield Elements : ubyte {
    Earth,    // 0x01
    Wind,     // 0x02
    Fire,     // 0x04
    Water,    // 0x08
    Undead,   // 0x10
    Ghost     // 0x20
}

bitfield Conditions : uword {
    Irritated,     // 0x0001
    Crazy,         // 0x0002
    Sleep,         // 0x0004
    Panic,         // 0x0008
    Blind,         // 0x0010
    Drugged,       // 0x0020
    Exhausted,     // 0x0040
    Unused,        // 0x0080
    Petrified,     // 0x0100
    Diseased,      // 0x0200
    Aging,         // 0x0400
    DeadCorpse,    // 0x0800
    DeadAshes,     // 0x1000
    DeadDust       // 0x2000
}

// Ambermoon Advanced only — stored at offset 0x000B for monsters
bitfield AdvancedMonsterFlags : ubyte {
    ImmuneNoElement,   // 0x01 — misses every attack without element
    Unused,            // 0x02
    ImmuneGhost,       // 0x04
    ImmuneUndead,      // 0x08
    ImmuneEarth,       // 0x10
    ImmuneWind,        // 0x20
    ImmuneFire,        // 0x40
    ImmuneWater        // 0x80
}

// Each stat/ability has four components: current, max, signed bonus, backup.
// Total size: 8 bytes.
struct CharacterValue {
    uword Current
    uword Max
    sword Bonus
    uword Backup
}

// ---------------------------------------------------------------
// Base character record (offsets are from the start of the record)
// ---------------------------------------------------------------
struct Character {
    [0x0000]
    CharacterType Type
    Gender Gender
    Race Race
    Class Class
    SpellTypes UsableSpellTypes
    ubyte Level
    ubyte NumOccupiedHands
    ubyte NumOccupiedFingers
    Languages SpokenLanguages
    ubyte InventoryInaccessible
    ubyte PortraitIndex
    [0x000B]
    ubyte JoinPercentage          // 0 = will never join; only used in Amberstar
    ubyte CombatGraphicIndex      // monsters only
    ubyte SpellChancePercentage   // monsters only (unused in Ambermoon)
    ubyte MagicBonusToHit         // monsters only (unused in Ambermoon)
    ubyte MonsterMorale           // retreat chance; 100 = never flee
    SpellTypes SpellImmunity
    ubyte AttacksPerRound
    BattleFlags BattleFlags
    Elements ElementsAndImmunities
    [0x0014]
    uword SpellLearningPoints
    uword TrainingPoints
    [0x0018]
    uword Gold
    uword Food
    uword CharacterBitIndex       // 0xFFFF = not used; 0x0000 on Gryban is a bug
    Conditions Conditions
    uword MonsterExperience       // XP rewarded when this monster is defeated
    uword BattleRoundSpellPointUsage
    uword MarkOfReturnX
    uword MarkOfReturnY
    uword MarkOfReturnMapIndex
    [0x002A]
    CharacterValue[8] Attributes  // STR, INT, DEX, SPD, STA, CHA, LUK, AntiMagic
    [0x006A]
    CharacterValue Age
    CharacterValue SpellDamageBonus  // 10th attribute (Ambermoon Advanced)
    [0x007A]
    CharacterValue[10] Abilities  // ATT, PAR, SWI, CRI, FindTraps, DisarmTraps, LockPick, Search, ReadMagic, UseMagic
    [0x00CA]
    uword CurrentHitPoints
    uword MaxHitPoints
    uword BonusHitPoints
    uword CurrentSpellPoints
    uword MaxSpellPoints
    uword BonusSpellPoints
    sword BaseDefense             // monsters only
    sword BonusDefense            // from equipment
    sword BaseAttackDamage        // monsters only
    sword BonusAttackDamage       // from equipment
    uword MagicAttackLevel
    uword MagicDefenseLevel
    uword APRIncreaseLevels       // APR = max(1, Level / APRIncreaseLevels)
    uword HitPointsPerLevel
    uword SpellPointsPerLevel
    uword SpellLearningPointsPerLevel
    uword TrainingPointsPerLevel
    uword LookTextIndex           // 0xFFFF = none
    [0x00EE]
    udword Experience
    udword LearnedHealingSpells
    udword LearnedAlchemisticSpells
    udword LearnedMysticSpells
    udword LearnedDestructionSpells
    udword[3] LearnedFunctionalSpells
    udword Weight
    [0x0112]
    ubyte[16] Name               // DOS Latin-1 (codepage 850), null-terminated
}

// ---------------------------------------------------------------
// Monster-specific record — inherits all Character fields
// ---------------------------------------------------------------

// Each animation stores 32 frame indices (into the monster graphic).
struct AnimationInfo {
    ubyte[32] FrameIndices
}

struct Monster : Character {
    Type = CharacterType.Monster
    [0x000B]
    new AdvancedMonsterFlags MonsterFlags  // replaces JoinPercentage in Character
    [0x01E8]
    AnimationInfo[8] Animations  // Move, ShortAttack, LongAttack, Cast, Hurt, Die, StartAnim, Unknown
    ubyte[8] FrameCounts
    ubyte[16] AtariPalette
    ubyte[32] AmigaPalette
    ubyte AnimationDirectionFlags  // bit N set = animation N plays backwards after finishing
    ubyte Padding
    [0x0322]
    uword FrameWidth
    uword FrameHeight
    uword MappedFrameWidth
    uword MappedFrameHeight
}
